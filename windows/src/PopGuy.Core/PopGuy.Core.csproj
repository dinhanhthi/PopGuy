<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Portable: no Windows API, so it builds and tests on the Mac. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PopGuy.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PopGuy.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- PopClip Config.yaml: parsed as events into plain dictionaries and lists, never into typed objects. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
</Project>
