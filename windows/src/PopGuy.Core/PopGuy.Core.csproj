<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Portable: no Windows API, so it builds and tests on the Mac. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PopGuy.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PopGuy.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- PopClip Config.yaml: parsed as events into plain dictionaries and lists, never into typed objects. -->
    <PackageReference Include="YamlDotNet" />
    <!-- Babylon .bgl indexes; ships the native SQLite library for every runtime. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- The emoji picker data, shared with macOS: linked, never copied. -->
    <EmbeddedResource Include="../../../macos/PopGuy/Resources/Emoji/emoji.json" Link="Emoji/emoji.json" LogicalName="PopGuy.Core.Emoji.emoji.json" />
    <EmbeddedResource Include="../../../macos/PopGuy/Resources/Emoji/symbols.json" Link="Emoji/symbols.json" LogicalName="PopGuy.Core.Emoji.symbols.json" />
  </ItemGroup>
</Project>
