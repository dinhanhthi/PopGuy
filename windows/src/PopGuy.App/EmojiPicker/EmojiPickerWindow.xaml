<?xml version="1.0" encoding="utf-8"?>
<!--
    The emoji picker's window (macOS EmojiPickerView.swift and EmojiGridView.swift, 360 × 333): the search header with
    the Settings gear, then the Emoji/Symbols tabs and the category row (browsing only), the grid and the footer with
    the selected emoji's name. The grid is a virtualized ItemsRepeater over flattened rows (a section header, or up to
    9 cells), built in code from the model's sections. Only the search box takes focus: every button and cell has
    AllowFocusOnInteraction="False", so the arrows, Enter and Esc keep reaching the box. The box has no context or
    selection flyout (their command bars attach default tooltips); tooltips come only from HoverTooltip. No background:
    the acrylic backdrop shows through (the solid base background when acrylic is not supported).
-->
<Window
    x:Class="PopGuy.EmojiPicker.EmojiPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pgc="using:PopGuy.Controls"
    Title="PopGuy emoji picker">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- The tabs: the selected one is a raised segment on the track, the other a subtle one. -->
            <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <Style x:Key="TabSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <!-- The category icons: secondary at rest, primary when they hold the selection (the pointer tints them too). -->
            <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <Style x:Key="CategorySelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- The underline under the category that holds the selection. -->
            <Style x:Key="CategoryUnderlineStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="2" />
                <Setter Property="RadiusX" Value="1" />
                <Setter Property="RadiusY" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <!-- A section's title above its cells. -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="4,6,4,2" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <!-- The selected cell's accent-tinted rounded rect (under the glyph, so the glyph keeps its colors). -->
            <Style x:Key="CellHighlightStyle" TargetType="Rectangle">
                <Setter Property="RadiusX" Value="6" />
                <Setter Property="RadiusY" Value="6" />
                <Setter Property="Opacity" Value="0.25" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="CellTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Header: the search glyph, the search box and the Settings gear (its tooltip is HoverTooltip's). -->
        <Grid
            Grid.Row="0"
            Padding="12,0,8,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE721;" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search emoji"
                ContextFlyout="{x:Null}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                PlaceholderText="Search emoji"
                SelectionFlyout="{x:Null}" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Width="30"
                Height="30"
                Padding="0"
                VerticalAlignment="Center"
                pgc:HoverTooltip.Text="Settings"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Settings"
                CornerRadius="15"
                IsTabStop="False"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Glyph="&#xE713;" />
            </Button>
        </Grid>

        <Rectangle
            Grid.Row="1"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Browsing only (an empty query): the tabs above one icon per section of the tab. -->
            <StackPanel
                x:Name="Navigation"
                Grid.Row="0"
                Padding="8,7,8,4"
                Spacing="4">
                <Grid
                    Padding="2"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    ColumnSpacing="2"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="EmojiTabButton"
                        Grid.Column="0"
                        Content="Emoji"
                        Style="{StaticResource TabSelectedButtonStyle}" />
                    <Button
                        x:Name="SymbolsTabButton"
                        Grid.Column="1"
                        Content="Symbols"
                        Style="{StaticResource TabButtonStyle}" />
                </Grid>
                <StackPanel
                    x:Name="CategoryRow"
                    Height="28"
                    Orientation="Horizontal"
                    Spacing="4" />
            </StackPanel>
            <Rectangle
                x:Name="NavigationDivider"
                Grid.Row="1"
                Height="1"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <ScrollViewer
                x:Name="GridScroller"
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                IsTabStop="False"
                VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="RowsRepeater" Margin="8,0,8,8">
                    <ItemsRepeater.Layout>
                        <StackLayout />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <!-- Filled in code (ElementPrepared): a header row or a row of up to 9 cells. -->
                        <DataTemplate>
                            <Grid Background="Transparent" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- A search with no hits. -->
            <StackPanel
                x:Name="EmptyState"
                Grid.Row="0"
                Grid.RowSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No emoji found" />
            </StackPanel>
        </Grid>

        <Rectangle
            Grid.Row="3"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- The selected emoji's name. -->
        <TextBlock
            x:Name="FooterText"
            Grid.Row="4"
            Margin="12,0,12,0"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            MaxLines="1"
            Text="No results"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
    </Grid>
</Window>
