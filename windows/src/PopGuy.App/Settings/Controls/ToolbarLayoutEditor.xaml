<?xml version="1.0" encoding="utf-8"?>
<!--
    The toolbar layout editor at the top of Settings → Actions (macOS ToolbarLayoutEditorView.swift). Row 1 is the real
    toolbar (ToolbarView, not hit-testable) on its card, then the editor's own More card: beside the toolbar,
    top aligned, when both fit the width, else on row 2 (the orientation and margin are set in code); both cards are
    built in code (ToolbarLayoutEditor.xaml.cs). Behind them, a "More actions" connector joins the cards: a straight
    line with the label in its middle side by side, an elbow with the label on its horizontal run on row 2. The surface takes the pointer for both cards (drag to reorder or move
    between them); the overlay holds the hover targets over the toolbar's actions and the drag ghost. The soft width warning shows below. The backdrop is a mid-tone "wallpaper" that both card
    themes stand out on (macOS ToolbarPreviewBackdrop). Settings → Appearance uses it preview-only (Initialize): row 1
    alone, centered, with no drag, hover names or warning (macOS ToolbarPreviewView).
-->
<UserControl
    x:Class="PopGuy.Settings.Controls.ToolbarLayoutEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <StackPanel Spacing="8">
        <Border CornerRadius="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FF6B73AD" />
                    <GradientStop Offset="1" Color="#FF9E7A9E" />
                </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer
                x:Name="Viewport"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid
                    x:Name="Surface"
                    HorizontalAlignment="Left"
                    Background="Transparent">
                    <!-- The "More actions" connector, behind the cards; placed and shown in code (editable only).
                         Hidden by opacity, not collapsed, so its label can be measured before it shows. -->
                    <Canvas
                        x:Name="Connector"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <Polyline
                            x:Name="ConnectorLineA"
                            Stroke="#CCFFFFFF"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1" />
                        <Polyline
                            x:Name="ConnectorLineB"
                            Stroke="#CCFFFFFF"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1" />
                        <TextBlock
                            x:Name="ConnectorLabel"
                            Foreground="#CCFFFFFF"
                            Text="More actions" />
                    </Canvas>
                    <!-- The same space on every side of the cards. -->
                    <StackPanel x:Name="SurfaceContent" Padding="12">
                        <!-- The toolbar's card: the preview sits in a Canvas sized to its zoomed card in code. -->
                        <Border
                            x:Name="ToolbarCard"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Canvas x:Name="PreviewHost" />
                        </Border>
                        <!-- More actions: one chip per action (or an empty slot), built in code; titled by the connector. -->
                        <Border
                            x:Name="MoreCard"
                            Margin="0,6,0,0"
                            Padding="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel
                                x:Name="MoreRow"
                                Orientation="Horizontal"
                                Spacing="4" />
                        </Border>
                    </StackPanel>
                    <Canvas x:Name="Overlay" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- A soft warning, never a cap (ToolbarLimits.ToolbarWidthWarningThreshold). -->
        <Grid x:Name="WidthWarning" ColumnSpacing="6" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Top"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="&#xE7BA;" />
            <TextBlock
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Your toolbar is getting wide and may cover more of your work. Consider moving some actions to More actions or turning off labels."
                TextWrapping="Wrap" />
        </Grid>
    </StackPanel>
</UserControl>
