<?xml version="1.0" encoding="utf-8"?>
<!--
    The custom action icon picker (macOS IconPickerView.swift), shown in the Add/Edit panel's Icon flyout: an SF Symbol
    tab (search, then the curated symbols drawn as Segoe Fluent glyphs) and an Emoji tab (a box for any emoji, then the
    quick picks). WinUI has no segmented picker: a SelectorBar stands in. The cells are built in code
    (IconPicker.xaml.cs); the styles below give them their theme colours.
-->
<UserControl
    x:Class="PopGuy.Settings.Controls.IconPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="320"
    IsTabStop="False">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentTintBrush" Opacity="0.25" Color="{ThemeResource SystemAccentColor}" />
        <Style x:Key="CellButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style x:Key="CellStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="SelectedSymbolCellStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SelectedEmojiCellStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
        </Style>
        <Style x:Key="GlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SelectedGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <SelectorBar x:Name="ModeBar" AutomationProperties.Name="Icon type">
            <SelectorBarItem Text="SF Symbol" />
            <SelectorBarItem Text="Emoji" />
        </SelectorBar>

        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel x:Name="SymbolPanel" Spacing="8">
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search"
                PlaceholderText="Search" />
            <TextBlock
                x:Name="NoResultsText"
                MinHeight="80"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Padding="0,30,0,0"
                Text="No results"
                Visibility="Collapsed" />
            <ScrollViewer
                x:Name="SymbolScroller"
                MinHeight="120"
                MaxHeight="220">
                <VariableSizedWrapGrid
                    x:Name="SymbolGrid"
                    Margin="1"
                    ItemHeight="42"
                    ItemWidth="42"
                    Orientation="Horizontal" />
            </ScrollViewer>
        </StackPanel>

        <StackPanel
            x:Name="EmojiPanel"
            Spacing="8"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Custom" />
                <TextBox
                    x:Name="EmojiBox"
                    Width="140"
                    AutomationProperties.Name="Custom emoji"
                    PlaceholderText="Type or paste emoji" />
            </StackPanel>
            <!-- macOS has a More… button for its character palette; a desktop app has no supported call that opens the Windows emoji panel. -->
            <TextBlock Style="{StaticResource CaptionStyle}" Text="In the box, press Windows + . for every emoji." />

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="Quick pick" />
            <ScrollViewer MinHeight="100" MaxHeight="200">
                <VariableSizedWrapGrid
                    x:Name="EmojiGrid"
                    Margin="1"
                    ItemHeight="42"
                    ItemWidth="42"
                    Orientation="Horizontal" />
            </ScrollViewer>
        </StackPanel>
    </StackPanel>
</UserControl>
