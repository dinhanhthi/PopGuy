<?xml version="1.0" encoding="utf-8"?>
<!--
    The Speak rows of an action card on Settings → Actions (macOS ActionsView.swift SpeakCardView for Speak,
    CustomSpeechFields for a custom Speech action): the speech engine with the cloud fallback and privacy notes, the
    cloud model and voice (OpenAI), the voice per language (Google, Azure; Speak only), the default accent, the system
    voice (Speak only), speed, pitch and Preview. ActionCard moves these rows into its expander (SpeakCard.TakeRows), so
    they take the expander's row style; they use only app-wide resources. The voice test buttons are added in code.
-->
<UserControl
    x:Class="PopGuy.Settings.Controls.SpeakCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False">

    <StackPanel x:Name="RowsPanel">

        <!-- Engine: System voice, then each cloud provider with a saved key (and the saved one). -->
        <controls:SettingsCard x:Name="EngineCard" Header="Speech engine">
            <controls:SettingsCard.Description>
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="EngineNote"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="PrivacyNote"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </controls:SettingsCard.Description>
            <ComboBox
                x:Name="EngineBox"
                MinWidth="200"
                AutomationProperties.Name="Speech engine" />
        </controls:SettingsCard>

        <!-- Cloud model (OpenAI): the curated models, then Custom… with a text box. -->
        <controls:SettingsCard x:Name="ModelCard" Header="Model">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox
                    x:Name="ModelBox"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Model" />
                <TextBox
                    x:Name="ModelText"
                    Width="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Custom model"
                    Visibility="Collapsed" />
            </StackPanel>
        </controls:SettingsCard>

        <!-- Cloud voice for every language (OpenAI's voices are multilingual), then its test button. -->
        <controls:SettingsCard x:Name="VoiceCard" Header="Voice">
            <StackPanel
                x:Name="VoiceRow"
                Orientation="Horizontal"
                Spacing="4">
                <ComboBox
                    x:Name="VoiceBox"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Voice" />
            </StackPanel>
        </controls:SettingsCard>

        <!-- Per-language cloud voices (Google, Azure): a language, its voice, then its test button. Speak only. -->
        <controls:SettingsCard
            x:Name="LanguageVoicesCard"
            Description="Each language uses its own voice; Default picks the best available."
            Header="Voices">
            <StackPanel
                x:Name="LanguageVoicesRow"
                Orientation="Horizontal"
                Spacing="4">
                <ComboBox
                    x:Name="VoiceLanguageBox"
                    MinWidth="140"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Voice language" />
                <ComboBox
                    x:Name="LanguageVoiceBox"
                    MinWidth="240"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Voice for this language" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Default Accent">
            <controls:SettingsCard.Description>
                <TextBlock
                    x:Name="AccentNote"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The accent used to read text aloud by default."
                    TextWrapping="Wrap" />
            </controls:SettingsCard.Description>
            <ComboBox
                x:Name="AccentBox"
                MinWidth="160"
                AutomationProperties.Name="Default Accent" />
        </controls:SettingsCard>

        <!-- The system voices of the default accent's language (OneCore voices). Speak only. -->
        <controls:SettingsCard x:Name="SystemVoiceCard" Header="System voice">
            <controls:SettingsCard.Description>
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="NoVoicesNote"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Add more voices in Windows Settings → Time &amp; language → Speech."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <Grid
                        x:Name="FallbackWarning"
                        ColumnSpacing="6"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE7BA;" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="The System voice is still used as a fallback when the cloud voice is unavailable — missing API key, offline, or text longer than the cloud limit."
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </controls:SettingsCard.Description>
            <ComboBox
                x:Name="SystemVoiceBox"
                MinWidth="240"
                AutomationProperties.Name="System voice" />
        </controls:SettingsCard>

        <!-- Speed and pitch, 1-10 (5 is the natural rate). No thumb tooltip: the app shows HoverTooltip only. -->
        <controls:SettingsCard Header="Speed">
            <controls:SettingsCard.Description>
                <TextBlock
                    x:Name="SpeedNote"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </controls:SettingsCard.Description>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Slider
                    x:Name="SpeedSlider"
                    Width="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Speed"
                    IsThumbToolTipEnabled="False"
                    Maximum="10"
                    Minimum="1"
                    SnapsTo="StepValues"
                    StepFrequency="1" />
                <TextBlock
                    x:Name="SpeedValue"
                    MinWidth="44"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Pitch">
            <controls:SettingsCard.Description>
                <TextBlock
                    x:Name="PitchNote"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </controls:SettingsCard.Description>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Slider
                    x:Name="PitchSlider"
                    Width="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Pitch"
                    IsThumbToolTipEnabled="False"
                    Maximum="10"
                    Minimum="1"
                    SnapsTo="StepValues"
                    StepFrequency="1" />
                <TextBlock
                    x:Name="PitchValue"
                    MinWidth="44"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </controls:SettingsCard>

        <!-- Preview: an editable sample in the accent's language, Preview (Stop while it plays, a spinner while it loads). -->
        <controls:SettingsCard
            HorizontalContentAlignment="Stretch"
            ContentAlignment="Vertical"
            Header="Preview">
            <StackPanel Spacing="6">
                <TextBox
                    x:Name="SampleBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Sample text"
                    PlaceholderText="Sample text" />
                <Button x:Name="PreviewButton" AutomationProperties.Name="Preview">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="16" Height="16">
                            <FontIcon
                                x:Name="PreviewIcon"
                                FontSize="14"
                                Glyph="&#xE767;" />
                            <ProgressRing
                                x:Name="PreviewRing"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="PreviewLabel" Text="Preview" />
                    </StackPanel>
                </Button>
                <TextBlock
                    x:Name="PreviewFallbackText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Cloud voice unavailable — previewing with the System voice."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
