<?xml version="1.0" encoding="utf-8"?>
<!--
    The Action Library panel (macOS ActionLibraryView.swift), shown as the SlideOverPanel's centered modal: a header
    (title, subtitle, Done) with the panel's symmetric padding, the search row, then the scrolling category sections of
    preset cards. The sections and cards are built in code (ActionLibraryPanel.xaml.cs); the styles below give them their
    theme colours.
-->
<UserControl
    x:Class="PopGuy.Settings.Panels.ActionLibraryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <UserControl.Resources>
        <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SecondaryIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CodeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: its padding is SlideOverPanel.HeaderPadding (set in code). -->
        <Grid x:Name="HeaderBar" Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Action Library" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="Ready-made actions — install with one click." />
                <TextBlock
                    x:Name="SaveErrorText"
                    Style="{StaticResource ErrorTextStyle}"
                    Text="The action was not installed: the settings file could not be written."
                    Visibility="Collapsed" />
            </StackPanel>
            <Button
                x:Name="DoneButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="Done"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Rectangle
            Grid.Row="1"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Search: the same MaxWidth as the cards, so both line up on wide windows. -->
        <Grid Grid.Row="2" Padding="24,10,24,10">
            <TextBox
                x:Name="SearchBox"
                MaxWidth="1000"
                AutomationProperties.Name="Search actions"
                PlaceholderText="Search actions…" />
        </Grid>

        <Rectangle
            Grid.Row="3"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <ScrollViewer Grid.Row="4">
            <!-- A stretched Grid takes the viewport width: a MaxWidth child placed straight in the ScrollViewer is centered by its narrower desired width and overflows the right edge on wide windows. -->
            <Grid>
                <StackPanel
                    x:Name="BodyPanel"
                    MaxWidth="1000"
                    Margin="24,20,24,24"
                    Spacing="20" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
