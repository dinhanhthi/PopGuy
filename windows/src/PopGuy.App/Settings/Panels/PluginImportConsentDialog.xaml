<?xml version="1.0" encoding="utf-8"?>
<!--
    The import consent panel (macOS PluginImportConsentView.swift), shown in the SlideOverPanel for every import path: a
    header (title, source, counters, Cancel, Add to PopGuy) with the panel's symmetric padding, then the scrolling body
    (security note, the actions to add, the items not imported). The body is built in code
    (PluginImportConsentDialog.xaml.cs); the styles below give it its theme colours.
-->
<UserControl
    x:Class="PopGuy.Settings.Panels.PluginImportConsentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,20,0,4" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CautionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CautionIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="SecondaryIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CodeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: its padding is SlideOverPanel.HeaderPadding (set in code). -->
        <Grid x:Name="HeaderBar" Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Import plugin" />
                <TextBlock
                    x:Name="SourceText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SaveErrorText"
                    Style="{StaticResource ErrorTextStyle}"
                    Text="Not all actions were added: the settings file could not be written."
                    Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="AddCountText"
                    HorizontalAlignment="Right"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Name="SkippedCountText"
                    HorizontalAlignment="Right"
                    Style="{StaticResource CautionTextStyle}" />
            </StackPanel>
            <Button
                x:Name="CancelButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="Cancel" />
            <Button
                x:Name="AddButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                Content="Add to PopGuy"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Rectangle
            Grid.Row="1"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <ScrollViewer Grid.Row="2">
            <!-- A stretched Grid takes the viewport width: a MaxWidth child placed straight in the ScrollViewer is centered by its narrower desired width and overflows the right edge on wide windows. -->
            <Grid>
                <StackPanel
                    x:Name="BodyPanel"
                    MaxWidth="1000"
                    Margin="24,20,24,24"
                    Spacing="8" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
