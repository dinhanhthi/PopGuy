<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Actions (macOS ActionsView.swift): a fixed header (the Settings-button switch, then the search box and
    the type filter) above the scrolling action cards, one per action in the action order. The cards are built in code
    (ActionsPage.xaml.cs, Controls/ActionCard). The toolbar layout editor (task 14.3) goes first in HeaderPanel, above the
    switch row. Speak and Look up get their cards in Phase 19; adding, importing, exporting and editing custom actions
    come in Phases 15 and 16. The header is the window's.
-->
<Page
    x:Class="PopGuy.Settings.Pages.ActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            x:Name="HeaderPanel"
            Grid.Row="0"
            MaxWidth="1000"
            Margin="24,16,24,8"
            Spacing="8">

            <!-- The toolbar's Settings button (macOS keeps this switch on the Actions page). -->
            <ToggleSwitch
                x:Name="SettingsButtonToggle"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Show Settings button on toolbar"
                OffContent="Show Settings button on toolbar"
                OnContent="Show Settings button on toolbar" />

            <!-- Search and type filter. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="Search actions"
                    PlaceholderText="Search actions…" />
                <ComboBox
                    x:Name="TypeFilterBox"
                    Grid.Column="1"
                    MinWidth="160"
                    AutomationProperties.Name="Filter actions by type" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <!-- A stretched Grid takes the viewport width: a MaxWidth child placed straight in the ScrollViewer is centered by its narrower desired width and overflows the right edge on wide windows. -->
            <Grid>
                <StackPanel
                    x:Name="CardsPanel"
                    MaxWidth="1000"
                    Margin="24,0,24,24"
                    Spacing="4" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
