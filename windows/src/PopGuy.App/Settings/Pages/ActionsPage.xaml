<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Actions (macOS ActionsView.swift): a fixed header (the toolbar layout editor, the Settings-button switch,
    then the search box and the type filter) above the scrolling action cards, one per action in the action order. The
    cards are built in code (ActionsPage.xaml.cs, Controls/ActionCard). Add action and a custom card's Edit open the
    Add/Edit panel (Panels/CustomActionEditPanel); Import and the plugin menu end in the consent panel
    (Panels/PluginImportConsentDialog); the library button opens the Action Library (Panels/ActionLibraryPanel). Speak and
    Look up get their cards in Phase 19. The header is the window's.
-->
<Page
    x:Class="PopGuy.Settings.Pages.ActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PopGuy.Settings.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            x:Name="HeaderPanel"
            Grid.Row="0"
            MaxWidth="1000"
            Margin="24,16,24,8"
            Spacing="8">

            <!-- The live toolbar preview: drag to reorder or to move actions to and from More actions. -->
            <controls:ToolbarLayoutEditor x:Name="LayoutEditor" />

            <!-- The toolbar's Settings button (macOS keeps this switch on the Actions page), then Add action, Export, Import, the plugin menu (built in code) and the Action Library. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleSwitch
                    x:Name="SettingsButtonToggle"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Show Settings button on toolbar"
                    OffContent="Show Settings button on toolbar"
                    OnContent="Show Settings button on toolbar" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="AddButton"
                        AutomationProperties.Name="Add action"
                        Style="{StaticResource AccentButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button x:Name="ExportButton" AutomationProperties.Name="Export custom actions">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                    </Button>
                    <Button x:Name="ImportButton" AutomationProperties.Name="Import custom actions">
                        <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                    </Button>
                    <Button x:Name="PluginButton" AutomationProperties.Name="Import plugin">
                        <FontIcon FontSize="14" Glyph="&#xEA86;" />
                    </Button>
                    <Button x:Name="LibraryButton" AutomationProperties.Name="Browse Action Library">
                        <FontIcon FontSize="14" Glyph="&#xE8F1;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search and type filter. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="Search actions"
                    PlaceholderText="Search actions…" />
                <ComboBox
                    x:Name="TypeFilterBox"
                    Grid.Column="1"
                    MinWidth="160"
                    AutomationProperties.Name="Filter actions by type" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <!-- A stretched Grid takes the viewport width: a MaxWidth child placed straight in the ScrollViewer is centered by its narrower desired width and overflows the right edge on wide windows. -->
            <Grid>
                <StackPanel
                    x:Name="CardsPanel"
                    MaxWidth="1000"
                    Margin="24,0,24,24"
                    Spacing="4" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
