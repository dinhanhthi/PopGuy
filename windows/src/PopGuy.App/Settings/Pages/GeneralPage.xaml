<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → General (macOS GeneralView.swift): Enable PopGuy, Start at login, the Global Prompt and the close
    confirmation, as Windows 11 Settings cards under the macOS section headers. The Dock toggle has no Windows
    counterpart; Setup Guide… comes with the wizard (Phase 22). The header is the window's.
-->
<Page
    x:Class="PopGuy.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,24,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Margin="24,16,24,24"
            Spacing="4">

            <TextBlock
                Margin="1,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="App" />

            <controls:SettingsCard
                Description="When off, every trigger — text selection, double-click, Ctrl+C+C, and hotkeys — is suppressed."
                Header="Enable PopGuy">
                <ToggleSwitch x:Name="EnabledToggle" AutomationProperties.Name="Enable PopGuy" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Start at login">
                <controls:SettingsCard.Description>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="LoginErrorText"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <TextBlock Text="Automatically launch PopGuy when you log in." TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SettingsCard.Description>
                <ToggleSwitch x:Name="LoginToggle" AutomationProperties.Name="Start at login" />
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Global Prompt" />

            <controls:SettingsCard
                ContentAlignment="Vertical"
                Description="Added to the beginning of every AI action's prompt — Improve, Shorten, Proofread, Translate, the Prompt action, and custom actions — so you don't repeat the same instruction in each one. Leave empty to disable. Available: {{app}}, {{date}}, {{language}}, {{domain}} (only when Ignored Domains is on)."
                HorizontalContentAlignment="Stretch">
                <TextBox
                    x:Name="PromptBox"
                    MinHeight="80"
                    HorizontalAlignment="Stretch"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Global Prompt"
                    TextWrapping="Wrap" />
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Closing the Toolbar" />

            <controls:SettingsCard
                Description="When on, clicking outside or pressing Escape after a result is ready asks for confirmation, so you don't dismiss it by accident."
                Header="Confirm before closing a finished result">
                <ToggleSwitch x:Name="ConfirmCloseToggle" AutomationProperties.Name="Confirm before closing a finished result" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
