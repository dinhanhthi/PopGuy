<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Providers (macOS SettingsView.swift APIKeysTab): a pinned segment bar above the provider cards of the
    picked segment. WinUI has no segmented picker: a SelectorBar stands in. Dictionary (Phase 18) joins the bar with its
    feature. The cards, key rows and Local AI's model rows are built in code (ProvidersPage.xaml.cs): the styles below
    give them their theme colours. The header is the window's.
-->
<Page
    x:Class="PopGuy.Settings.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SuccessIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="CriticalIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="CautionIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="SecondaryIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar
            x:Name="SegmentBar"
            Grid.Row="0"
            Margin="20,8,24,4"
            AutomationProperties.Name="Provider category">
            <SelectorBarItem Text="AI" />
            <SelectorBarItem Text="Local AI" />
            <SelectorBarItem Text="Translation" />
            <SelectorBarItem Text="Speech" />
        </SelectorBar>

        <ScrollViewer x:Name="CardsScroller" Grid.Row="1">
            <!-- A stretched Grid takes the viewport width: a MaxWidth child placed straight in the ScrollViewer is centered by its narrower desired width and overflows the right edge on wide windows. -->
            <Grid>
                <Grid MaxWidth="1000" Margin="24,8,24,24">
                    <StackPanel x:Name="AiCards" Spacing="8" />
                    <StackPanel x:Name="LocalCards" Spacing="8" Visibility="Collapsed" />
                    <StackPanel x:Name="TranslationCards" Spacing="8" Visibility="Collapsed" />
                    <StackPanel x:Name="SpeechCards" Spacing="8" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
