<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Appearance (macOS SettingsView.swift AppearanceView): a live toolbar preview at the top, then a SelectorBar
    (tabs, as on the Ignore page) switches between Toolbar Style (Bar / Menu, Show logo only and Show Settings button on
    toolbar), Toolbar Zoom (zoom, Hide logo (disabled while Show logo only is on) and the system buttons gap) and Result
    Text (font size with a sample), as Windows 11 Settings cards; the bar names them, so no tab repeats its name as a
    heading. WinUI has no segmented picker: a SelectorBar stands in. The preview is the Actions page's layout editor in
    preview-only mode (macOS reuses ToolbarPreviewView in both); it always shows the bar and stays above every tab.
    The header is the window's.
-->
<Page
    x:Class="PopGuy.Settings.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:settings="using:PopGuy.Settings.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The toolbar at its real size for the zoom, from the saved settings (macOS ToolbarPreviewView); above every tab. -->
        <settings:ToolbarLayoutEditor
            x:Name="ToolbarPreview"
            Grid.Row="0"
            MaxWidth="1000"
            Margin="24,16,24,0" />

        <SelectorBar
            x:Name="TabBar"
            Grid.Row="1"
            Margin="20,8,24,4"
            AutomationProperties.Name="Appearance sections">
            <SelectorBarItem Text="Toolbar style" />
            <SelectorBarItem Text="Toolbar zoom" />
            <SelectorBarItem Text="Result text" />
        </SelectorBar>

        <ScrollViewer x:Name="TabScroller" Grid.Row="2">
            <!-- A stretched Grid takes the viewport width: a MaxWidth child placed straight in the ScrollViewer is centered by its narrower desired width and overflows the right edge on wide windows. -->
            <Grid>
                <Grid MaxWidth="1000" Margin="24,8,24,24">
                    <StackPanel x:Name="StyleTab" Spacing="4">
                        <!-- The description is the selected style's caption, set in code. -->
                        <controls:SettingsCard x:Name="ToolbarStyleCard" Header="Toolbar style">
                            <SelectorBar x:Name="ToolbarStyleBar" AutomationProperties.Name="Toolbar style">
                                <SelectorBarItem Text="Bar" />
                                <SelectorBarItem Text="Menu" />
                            </SelectorBar>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="ShowLogoOnlyCard"
                            Description="When PopGuy is triggered, show only its logo next to the pointer. Click the logo to open the full toolbar."
                            Header="Show logo only">
                            <ToggleSwitch x:Name="ShowLogoOnlyToggle" AutomationProperties.Name="Show logo only" />
                        </controls:SettingsCard>

                        <!-- Moved here from the Actions page (macOS: the Toolbar Style group). -->
                        <controls:SettingsCard Description="Settings stay available from the PopGuy tray icon" Header="Show Settings button on toolbar">
                            <ToggleSwitch x:Name="ToolbarSettingsToggle" AutomationProperties.Name="Show Settings button on toolbar" />
                        </controls:SettingsCard>
                    </StackPanel>

                    <StackPanel
                        x:Name="ZoomTab"
                        Spacing="4"
                        Visibility="Collapsed">
                        <controls:SettingsCard
                            Description="Zoom level scales the entire floating toolbar — buttons, icons, and spacing — making it easier to see and click. 1× is the default size; higher levels make everything proportionally larger."
                            Header="Zoom level">
                            <SelectorBar x:Name="ZoomBar" AutomationProperties.Name="Zoom level">
                                <SelectorBarItem Text="1×" />
                                <SelectorBarItem Text="1.2×" />
                                <SelectorBarItem Text="1.3×" />
                            </SelectorBar>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Description="Turn off to keep the result text at its chosen size while everything else grows."
                            Header="Include font size in zoom">
                            <ToggleSwitch x:Name="ZoomFontToggle" AutomationProperties.Name="Include font size in zoom" />
                        </controls:SettingsCard>

                        <!-- The description is set in code: it changes while Show logo only is on. -->
                        <controls:SettingsCard x:Name="HideLogoCard" Header="Hide logo">
                            <ToggleSwitch x:Name="HideLogoToggle" AutomationProperties.Name="Hide logo" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Description="Show the Ignore and Settings buttons right after the actions, separated by dividers like any other action, instead of after a gap."
                            Header="Remove gap before system buttons">
                            <ToggleSwitch x:Name="InlineSystemButtonsToggle" AutomationProperties.Name="Remove gap before system buttons" />
                        </controls:SettingsCard>
                    </StackPanel>

                    <StackPanel
                        x:Name="ResultTextTab"
                        Spacing="4"
                        Visibility="Collapsed">
                        <controls:SettingsCard Header="Font size">
                            <controls:SettingsCard.Description>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="SampleText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="The quick brown fox jumps over the lazy dog."
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="Applies to the result shown in the toolbar after an action runs." TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                            <SelectorBar x:Name="FontSizeBar" AutomationProperties.Name="Font size">
                                <SelectorBarItem Text="Small" />
                                <SelectorBarItem Text="Normal" />
                                <SelectorBarItem Text="Big" />
                            </SelectorBar>
                        </controls:SettingsCard>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
