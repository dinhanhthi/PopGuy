<?xml version="1.0" encoding="utf-8"?>
<!--
    The floating toolbar (macOS ToolbarView.swift; the look is Fluent). The card sizes to its content inside a Canvas,
    so its size is the window's (top edge fixed). Every button has AllowFocusOnInteraction="False": focus would activate
    the window and take the foreground from the source app. Only the text boxes (prompt, refine, edit) take focus: the
    window activates for them on purpose (ToolbarWindow's text input). The card's background is Transparent, never
    unset: an unset background does not hit-test, and the padding is the drag handle. No tooltips anywhere (the buttons
    carry labels or an automation name); the selectable text blocks and the text boxes have no context or selection
    flyout (their command bars attach default tooltips).
-->
<Window
    x:Class="PopGuy.Toolbar.ToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PopGuy toolbar">

    <!-- No background: the acrylic backdrop shows through. -->
    <Canvas x:Name="RootCanvas">
        <StackPanel x:Name="Card" Background="Transparent">

            <!-- Action bar: logo, the inline actions (built in code from the settings), Close. -->
            <StackPanel
                x:Name="Bar"
                Padding="8,6,8,6"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="4">
                <Image
                    Width="26"
                    Height="26"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/ToolbarLogo.png"
                    Visibility="{x:Bind ViewModel.ShowsLogo, Mode=OneWay}" />
                <StackPanel
                    x:Name="ActionRow"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4" />
                <!-- Icon only; the name is for screen readers (no tooltip). -->
                <Button
                    x:Name="CloseButton"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Close"
                    AllowFocusOnInteraction="False"
                    Visibility="{x:Bind ViewModel.ShowsClose, Mode=OneWay}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE711;" />
                </Button>
            </StackPanel>

            <!-- Body: its width is set in code (the bar's width, at least 340), so the text wraps. -->
            <StackPanel x:Name="Body" Visibility="{x:Bind ViewModel.ShowsBody, Mode=OneWay}">
                <Rectangle
                    Height="1"
                    Margin="8,0,8,0"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Prompt input (macOS promptInputArea): Enter runs, Shift+Enter is a new line; Cancel closes the toolbar. -->
                <StackPanel
                    Padding="12,14,12,14"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.IsPromptInputActive, Mode=OneWay}">
                    <TextBox
                        x:Name="PromptBox"
                        MaxHeight="100"
                        AcceptsReturn="True"
                        ContextFlyout="{x:Null}"
                        PlaceholderText="Type a prompt for the selected text…"
                        SelectionFlyout="{x:Null}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Use {{text}} for the selected text — added automatically if omitted. Also: {{app}}, {{date}}, {{language}}, {{domain}}."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PromptRunButton"
                            AllowFocusOnInteraction="False"
                            Content="Run"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="PromptCancelButton"
                            AllowFocusOnInteraction="False"
                            Content="Cancel" />
                    </StackPanel>
                </StackPanel>
                <Rectangle
                    Height="1"
                    Margin="8,0,8,0"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.ShowsPromptDivider, Mode=OneWay}" />

                <!-- Running: the spinner, or the streamed text so far, then Stop. -->
                <StackPanel
                    Padding="12,14,12,14"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        IsActive="{x:Bind ViewModel.ShowsSpinner, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowsSpinner, Mode=OneWay}" />
                    <ScrollViewer MaxHeight="280" Visibility="{x:Bind ViewModel.ShowsProgressText, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Button
                        x:Name="StopButton"
                        HorizontalAlignment="Center"
                        AllowFocusOnInteraction="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE71A;" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--
                    Result: the Diff/Text toggle (Improve and Proofread), the selectable text, the inline diff or the
                    rendered Markdown (or the editor while editing), the refine input, then Copy, Paste back (editable
                    sources only), Edit/Done (non-diff results), Regenerate and Refine (icon only, as on macOS).
                -->
                <StackPanel
                    Padding="12,14,12,14"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsResult, Mode=OneWay}">
                    <!-- Above the result as on macOS (the button row has no room); checked states are set in code. -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        Visibility="{x:Bind ViewModel.IsDiffResult, Mode=OneWay}">
                        <ToggleButton
                            x:Name="DiffModeButton"
                            AllowFocusOnInteraction="False"
                            Content="Diff" />
                        <ToggleButton
                            x:Name="TextModeButton"
                            AllowFocusOnInteraction="False"
                            Content="Text" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="280" Visibility="{x:Bind ViewModel.ShowsReadView, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock
                                ContextFlyout="{x:Null}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                SelectionFlyout="{x:Null}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.ShowsPlainResult, Mode=OneWay}" />
                            <!-- The inline diff, built in code (DiffView); a click on a change accepts or rejects it. -->
                            <RichTextBlock
                                x:Name="DiffBlock"
                                ContextFlyout="{x:Null}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                SelectionFlyout="{x:Null}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.ShowsDiffView, Mode=OneWay}" />
                            <!-- The rendered Markdown ("Preserve & render formatting"), built in code (MarkdownView). -->
                            <RichTextBlock
                                x:Name="MarkdownBlock"
                                ContextFlyout="{x:Null}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                SelectionFlyout="{x:Null}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.ShowsMarkdownResult, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- The editor (macOS FullWidthTextEditor): it scrolls itself, so the caret stays in view. -->
                    <TextBox
                        x:Name="EditBox"
                        MinHeight="140"
                        MaxHeight="280"
                        AcceptsReturn="True"
                        ContextFlyout="{x:Null}"
                        SelectionFlyout="{x:Null}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowsEditor, Mode=OneWay}" />
                    <!-- The refine input (macOS inlineInputArea): Enter runs, Shift+Enter is a new line; Cancel closes it. -->
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsRefineInputActive, Mode=OneWay}">
                        <TextBox
                            x:Name="RefineBox"
                            MaxHeight="100"
                            AcceptsReturn="True"
                            ContextFlyout="{x:Null}"
                            PlaceholderText="How should it change? (e.g. shorter, more formal)"
                            SelectionFlyout="{x:Null}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RefineRunButton"
                                AllowFocusOnInteraction="False"
                                Content="Run"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="RefineCancelButton"
                                AllowFocusOnInteraction="False"
                                Content="Cancel" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="CopyButton" AllowFocusOnInteraction="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    x:Name="CopyIcon"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE8C8;" />
                                <TextBlock x:Name="CopyLabel" Text="Copy" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="PasteBackButton"
                            AllowFocusOnInteraction="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.ShowsPasteBack, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE77F;" />
                                <TextBlock Text="Paste back" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="EditButton"
                            AllowFocusOnInteraction="False"
                            Visibility="{x:Bind ViewModel.ShowsEditButton, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE70F;" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DoneButton"
                            AllowFocusOnInteraction="False"
                            Visibility="{x:Bind ViewModel.ShowsDoneButton, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE73E;" />
                                <TextBlock Text="Done" />
                            </StackPanel>
                        </Button>
                        <!-- Icon only, as on macOS (the row has no room for labels); the name is for screen readers. -->
                        <Button
                            x:Name="RegenerateButton"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Regenerate"
                            AllowFocusOnInteraction="False"
                            Visibility="{x:Bind ViewModel.ShowsRegenerate, Mode=OneWay}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE72C;" />
                        </Button>
                        <Button
                            x:Name="RefineButton"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Refine"
                            AllowFocusOnInteraction="False"
                            IsEnabled="{x:Bind ViewModel.RefineEnabled, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowsRefine, Mode=OneWay}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE8F2;" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}" />

                    <!-- The close confirmation (spec-1 §3.8): inline, since the toolbar never activates (no dialog). -->
                    <StackPanel
                        Margin="0,8,0,0"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsConfirmingClose, Mode=OneWay}">
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Close without using the result?"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Use Copy or Paste back to keep the result, or close anyway."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="CloseAnywayButton"
                            HorizontalAlignment="Stretch"
                            AllowFocusOnInteraction="False"
                            Content="Close Anyway" />
                        <Button
                            x:Name="DisableConfirmButton"
                            HorizontalAlignment="Stretch"
                            AllowFocusOnInteraction="False"
                            Content="Turn This Setting Off" />
                        <Button
                            x:Name="KeepOpenButton"
                            HorizontalAlignment="Stretch"
                            AllowFocusOnInteraction="False"
                            Content="Keep Open" />
                    </StackPanel>
                </StackPanel>

                <!-- Error: the warning and the selectable message, then Retry for a failed run. -->
                <StackPanel
                    Padding="12,14,12,14"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsError, Mode=OneWay}">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE7BA;" />
                        <TextBlock
                            Grid.Column="1"
                            ContextFlyout="{x:Null}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            IsTextSelectionEnabled="True"
                            SelectionFlyout="{x:Null}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <Button
                        x:Name="RetryButton"
                        AllowFocusOnInteraction="False"
                        Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE72C;" />
                            <TextBlock Text="Retry" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Canvas>
</Window>
